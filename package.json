{
  "name": "justblurry-mail",
  "version": "1.0.0",
  "description": "Email management system for @justblurry.com",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create justblurry-mail-db",
    "db:init": "wrangler d1 execute justblurry-mail-db --file=./schema.sql",
    "db:query": "wrangler d1 execute justblurry-mail-db --command"
  },
  "keywords": ["email", "cloudflare", "workers", "d1"],
  "author": "Wanz",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "wrangler": "^3.22.0"
  }
}
